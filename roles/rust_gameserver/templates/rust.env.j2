{#- Every value is shell-quoted. This file is SOURCED -- by the container entrypoint, by the
    image healthcheck as root, and by the bare-metal launcher -- so an unquoted value containing
    a space, a semicolon or $(...) would break startup or execute as that user. RUST_RCON_PASSWORD
    is the one that matters most and was previously unquoted. -#}
RUST_SERVER_STARTUP_ARGUMENTS={{ rust_gameserver_startup_args | quote }}
RUST_SERVER_IDENTITY={{ rust_gameserver_identity | quote }}
RUST_SERVER_MAXPLAYERS={{ rust_gameserver_maxplayers | quote }}
RUST_SERVER_NAME={{ rust_gameserver_name | quote }}
RUST_SERVER_DESCRIPTION={{ rust_gameserver_description | quote }}
RUST_SERVER_WORLDSIZE={{ rust_gameserver_worldsize | quote }}
RUST_RCON_PASSWORD={{ rust_gameserver_rcon_password | quote }}
RUST_UPDATE_CHECKING={{ rust_gameserver_update_checking | quote }}
RUST_SERVER_PORT={{ rust_gameserver_port | quote }}
RUST_SERVER_QUERYPORT={{ rust_gameserver_query_port | quote }}
RUST_SERVER_TAGS={{ rust_gameserver_tags | quote }}
RUST_RCON_PORT={{ rust_gameserver_rcon_port | quote }}
RUST_APP_PORT={{ rust_gameserver_app_port | quote }}
RUST_OXIDE_ENABLED={{ rust_gameserver_oxide_enabled | quote }}
RUST_OXIDE_UPDATE_ON_BOOT={{ rust_gameserver_oxide_update_on_boot | quote }}
RUST_HEARTBEAT={{ rust_gameserver_heartbeat | quote }}
RUST_SERVER_URL={{ rust_gameserver_url | quote }}
RUST_SERVER_BANNER_URL={{ rust_gameserver_banner_url | quote }}
RUST_WIPE_HOUR_OF_DAY={{ rust_gameserver_wipe_hour_of_day | quote }}
RUST_WIPE_DAY_OF_WEEK={{ rust_gameserver_wipe_day_of_week | quote }}
